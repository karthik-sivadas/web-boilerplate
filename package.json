{
  "name": "web-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.13.1",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "tsx scripts/local.ts dev",
    "setup:local": "tsx scripts/local.ts setup",
    "db:migrate": "tsx scripts/local.ts migrate",
    "db:up": "tsx scripts/local.ts database",
    "build": "turbo build --env-mode=loose",
    "start": "pnpm --filter web start",
    "auth:setup": "pnpm setup:local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint scripts tests *.ts && turbo lint --env-mode=loose",
    "typecheck": "tsc --noEmit && turbo typecheck --env-mode=loose",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:api": "pnpm --filter api test",
    "test:e2e": "playwright test",
    "test:artifact": "tsx tests/artifact-check.ts",
    "test:ssr": "tsx tests/ssr-lifetime-check.ts",
    "test:docker": "tsx tests/docker-smoke.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:api && pnpm build && pnpm test:artifact && pnpm test:ssr && pnpm test:e2e",
    "agent": "tsx scripts/agents/cli.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "@workspace/ui": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.2",
    "zod": "4.5.4",
    "turbo": "2.10.12",
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.58.2",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.0",
    "dotenv": "17.2.3",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "27.4.0",
    "playwright": "1.58.2",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "2.5.19",
    "shadcn": "4.21.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  }
}
