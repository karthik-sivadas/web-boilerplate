# Reference only. Prefer pnpm setup:local for missing-only generated private config.
# API process only; use secret management in production.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/web_boilerplate_dev
BETTER_AUTH_SECRET=replace-with-a-cryptographically-random-stable-secret
BETTER_AUTH_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
# Web process only: fixed private destination, no database URL or auth secret.
API_INTERNAL_URL=http://127.0.0.1:4000
# Explicit test-only administrator database. Never point these at development.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/web_boilerplate_test_admin
PG_TEST_ADMIN_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/web_boilerplate_test_admin
