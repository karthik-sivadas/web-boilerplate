# Optional public label. Never put Better Auth secrets in VITE_* variables.
VITE_APP_NAME=Workbench

# Production runtime only (not used by pnpm build). Use a random value of at
# least 32 characters; do not use example/change-me placeholder text.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://workbench.example.com
# AUTH_DATABASE_PATH=/absolute/persistent/path/auth.sqlite
